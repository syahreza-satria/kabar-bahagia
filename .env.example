# Database (Supabase Postgres - gunakan connection pooler)
DATABASE_URL=postgresql://postgres:password@host:6543/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# URL publik aplikasi (untuk link undangan & OG)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile (opsional; kosongkan untuk menonaktifkan)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rahasia untuk cron kedaluwarsa (Vercel mengirim sebagai Bearer)
CRON_SECRET=
