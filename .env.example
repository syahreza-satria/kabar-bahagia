# ============================================================
# KabarBahagia - contoh konfigurasi environment
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local (sudah masuk .gitignore).
# ============================================================

# --- Database (Supabase -> Connect -> Transaction pooler, port 6543) ---
# Ganti [KATA-SANDI] dengan kata sandi DATABASE (bukan kata sandi login admin).
# Karakter khusus pada kata sandi harus di-URL-encode (@ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[KATA-SANDI]@aws-0-xx.pooler.supabase.com:6543/postgres

# --- Supabase (Project Settings -> API) ---
# URL proyek SAJA, tanpa /rest/v1/ di belakangnya.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA: hanya dipakai server untuk upload/hapus media. Jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=
# Nama bucket Storage (harus PUBLIK). Bawaan: media
SUPABASE_MEDIA_BUCKET=media

# --- Alamat publik aplikasi (dipakai di link undangan & preview WhatsApp) ---
# Lokal: http://localhost:3000 | Produksi: https://nama-proyek.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Anti-spam Cloudflare Turnstile (opsional) ---
# Kosongkan keduanya untuk menonaktifkan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron kedaluwarsa otomatis (wajib di produksi) ---
# Isi dengan teks acak panjang. Vercel mengirimnya sebagai "Authorization: Bearer ...".
CRON_SECRET=
